{
  "name": "imy761",
  "private": true,
  "workspaces": [
    "apps/*/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev:plain:client": "npm run dev -w plain-client",
    "dev:plain:server": "npm run dev -w plain-server",
    "dev:gamified:client": "npm run dev -w gamified-client",
    "dev:gamified:server": "npm run dev -w gamified-server",
    "dev:plain": "concurrently -n client,server -c blue,green \"npm:dev:plain:client\" \"npm:dev:plain:server\"",
    "dev:gamified": "concurrently -n client,server -c blue,green \"npm:dev:gamified:client\" \"npm:dev:gamified:server\"",
    "dev": "concurrently -n plain,gamified -c yellow,magenta \"npm:dev:plain\" \"npm:dev:gamified\"",
    "build:plain:client": "npm run build -w plain-client",
    "build:gamified:client": "npm run build -w gamified-client",
    "typecheck:plain:server": "tsc --noEmit -p apps/plain/server/tsconfig.json",
    "typecheck:gamified:server": "tsc --noEmit -p apps/gamified/server/tsconfig.json",
    "typecheck:shared:server": "tsc --noEmit -p apps/shared/server/tsconfig.json",
    "build": "npm run build:plain:client && npm run build:gamified:client && npm run typecheck:shared:server && npm run typecheck:plain:server && npm run typecheck:gamified:server",
    "db:generate": "npm run db:generate -w shared-server",
    "db:migrate": "npm run db:migrate -w shared-server",
    "db:reset": "npm run db:reset -w shared-server",
    "db:deploy": "npm run db:deploy -w shared-server",
    "db:seed": "npm run db:seed -w shared-server",
    "db:studio": "npm run db:studio -w shared-server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nabla/vite-plugin-eslint": "^3.0.1",
    "@stylistic/eslint-plugin": "4.2.0",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "8.58.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.12"
  }
}

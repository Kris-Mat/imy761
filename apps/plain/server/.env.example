PORT_SERVER="3001"
PORT_CLIENT="4001"

# Postgres connection string (via Prisma). Both apps point at the same
# database, matching the shared schema in apps/shared/server/prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/imy761?schema=public"

# Supabase project (shared with apps/gamified), used to verify Auth JWTs. Project Settings -> API.
SUPABASE_URL=""
# Only needed if the project uses the legacy HS256 shared-secret scheme (Project Settings -> API -> JWT Keys).
# Leave blank if the project uses JWKS-based verification instead.
SUPABASE_JWT_SECRET=""

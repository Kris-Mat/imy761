{
  "entryFile": "server.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/controllers/**/*.controller.ts",
    "../../shared/server/src/controllers/**/*.controller.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@shared/*": ["../../shared/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "spec": {
    "outputDirectory": "src/swagger",
    "specVersion": 3,
    "securityDefinitions": {
      "jwt": { "type": "apiKey", "name": "Authorization", "in": "header" }
    }
  },
  "routes": {
    "routesDir": "src/swagger",
    "authenticationModule": "../../shared/server/src/middleware/auth.middleware.ts"
  }
}
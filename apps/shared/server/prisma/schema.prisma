generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int    @id @default(autoincrement())
  username  String
  email     String @unique
  firstName String
  lastName  String

  gameStat     UserGameStat?
  attempts     UserAttempt[]
  achievements UserAchievement[]
}

model Monolith {
  id            Int    @id @default(autoincrement())
  name          String
  modelUrl      String
  finalSoilForm String

  horizons  Horizon[]
  questions Question[]

  // A farm is the in-game "wrapper" around a soil profile: farmer identity,
  // description, and the dialogue that walks a player through this exact
  // Monolith's soil profile. One monolith = one farm.
  farm Farm?
}

model Horizon {
  id              Int    @id @default(autoincrement())
  depthTopMm      Int
  depthBottomMm   Int
  correctHue      String
  correctValue    Int
  correctChroma   Int

  monolith   Monolith @relation(fields: [monolithId], references: [id])
  monolithId Int

  diagRef   DiagnosticHorizonRef @relation(fields: [diagRefId], references: [id])
  diagRefId Int
}

model DiagnosticHorizonRef {
  id               Int    @id @default(autoincrement())
  name             String
  category         String
  criticalConcepts String

  horizons      Horizon[]
  ecosystemRefs EcosystemRef[]
}

// Renamed fields (previously landscapePos / agriUse / engineeringUse) to
// clearly reflect the three ecosystem contexts described in the source
// material: Natural, Agricultural and Urban.
model EcosystemRef {
  id                    Int    @id @default(autoincrement())
  naturalEcosystemNotes String
  agriculturalNotes     String
  urbanEcosystemNotes   String

  diagRef   DiagnosticHorizonRef @relation(fields: [diagRefId], references: [id])
  diagRefId Int
}

model UserGameStat {
  id       Int @id @default(autoincrement())
  totalXp  Int

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  level           Level @relation(fields: [currentLevelId], references: [id])
  currentLevelId  Int
}

// A Farm holds everything about the in-game location itself: which farmer
// runs it, a description of the place, and which soil profile (Monolith) it
// sits on. One farm always maps to exactly one soil profile.
model Farm {
  id          Int    @id @default(autoincrement())
  name        String // in-game location name, e.g. "The Rocky Outcrop"
  farmerName  String
  description String

  monolith   Monolith @relation(fields: [monolithId], references: [id])
  monolithId Int      @unique

  dialogLines FarmDialogLine[]
  level       Level?
}

// The sequenced narration/dialogue that leads a player through a farm's
// soil profile and questions. questionId is optional so intro/outro lines
// (not tied to a specific question) can still be sequenced in.
model FarmDialogLine {
  id       Int    @id @default(autoincrement())
  sequence Int
  speaker  String
  text     String

  farm   Farm @relation(fields: [farmId], references: [id])
  farmId Int

  question   Question? @relation(fields: [questionId], references: [id])
  questionId Int?
}

// Level is now just the game-progression wrapper around a Farm.
model Level {
  id          Int @id @default(autoincrement())
  levelNumber Int

  farm   Farm @relation(fields: [farmId], references: [id])
  farmId Int  @unique

  userGameStats UserGameStat[]
}

enum QuestionCategory {
  MUNSELL
  DELINEATION
}

model Question {
  id          Int               @id @default(autoincrement())
  category    QuestionCategory
  basePoints  Int
  description String

  monolith   Monolith @relation(fields: [monolithId], references: [id])
  monolithId Int

  attempts    UserAttempt[]
  dialogLines FarmDialogLine[]
}

model UserAttempt {
  id           Int       @id @default(autoincrement())
  isCorrect    Boolean
  pointsEarned Int
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId Int

  question   Question @relation(fields: [questionId], references: [id])
  questionId Int
}

model AchievementMaster {
  id           Int    @id @default(autoincrement())
  title        String
  description  String
  criteriaCode String // e.g., "UNLOCK_LEVEL_5"

  userAchievements UserAchievement[]
}

model UserAchievement {
  id       Int      @id @default(autoincrement())
  earnedAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  achievement   AchievementMaster @relation(fields: [achievementId], references: [id])
  achievementId Int

  @@unique([userId, achievementId])
}

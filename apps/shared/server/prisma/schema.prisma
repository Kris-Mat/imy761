generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int    @id @default(autoincrement())
  username  String
  email     String @unique
  firstName String
  lastName  String

  gameStat     UserGameStat?
  attempts     UserAttempt[]
  achievements UserAchievement[]
}

model Monolith {
  id            Int    @id @default(autoincrement())
  name          String
  imageUrl      String
  finalSoilForm String
  orderIndex    Int

  horizons       Horizon[]
  questions      Question[]
  soilFamilyCode SoilFamilyCode?
}

model Horizon {
  id            Int    @id @default(autoincrement())
  label         String
  orderIndex    Int
  colourText    String
  colourHue     String
  colourValue   Int
  colourChroma  Int

  monolith   Monolith @relation(fields: [monolithId], references: [id])
  monolithId Int

  characteristics HorizonCharacteristic[]
}

// Reuses the DiagnosticHorizonRef table slot: was a shared horizon-type
// reference, now the per-horizon characteristic bullet list.
model HorizonCharacteristic {
  id         Int    @id @default(autoincrement())
  text       String
  orderIndex Int

  horizon   Horizon @relation(fields: [horizonId], references: [id])
  horizonId Int
}

// Reuses the EcosystemRef table slot: was a shared landscape/use reference,
// now a generic MCQ answer option (used by every Question below).
model AnswerOption {
  id         Int     @id @default(autoincrement())
  text       String
  isCorrect  Boolean
  orderIndex Int

  question   Question @relation(fields: [questionId], references: [id])
  questionId Int
}

model SoilFamilyCode {
  id             Int    @id @default(autoincrement())
  finalCode      String
  soilFamilyName String

  monolith   Monolith @relation(fields: [monolithId], references: [id])
  monolithId Int      @unique

  fields SoilFamilyField[]
}

model SoilFamilyField {
  id           Int    @id @default(autoincrement())
  label        String
  correctValue String
  orderIndex   Int

  soilFamilyCode   SoilFamilyCode @relation(fields: [soilFamilyCodeId], references: [id])
  soilFamilyCodeId Int
}

model UserGameStat {
  id       Int @id @default(autoincrement())
  totalXp  Int

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  level           Level @relation(fields: [currentLevelId], references: [id])
  currentLevelId  Int
}

model Level {
  id          Int    @id @default(autoincrement())
  levelNumber Int
  title       String
  description String
  farmerName  String
  scenario    String

  userGameStats UserGameStat[]
}

enum QuestionCategory {
  DIAGNOSTIC_HORIZONS
  SOIL_FORM
  LANDSCAPE_POSITION
  SUITABILITY
}

model Question {
  id         Int              @id @default(autoincrement())
  category   QuestionCategory
  orderIndex Int
  prompt     String

  monolith   Monolith @relation(fields: [monolithId], references: [id])
  monolithId Int

  options  AnswerOption[]
  attempts UserAttempt[]
}

model UserAttempt {
  id           Int       @id @default(autoincrement())
  isCorrect    Boolean
  pointsEarned Int
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  user   User @relation(fields: [userId], references: [id])
  userId Int

  question   Question @relation(fields: [questionId], references: [id])
  questionId Int
}

model AchievementMaster {
  id           Int    @id @default(autoincrement())
  title        String
  description  String
  criteriaCode String // e.g., "UNLOCK_LEVEL_5"

  userAchievements UserAchievement[]
}

model UserAchievement {
  id       Int      @id @default(autoincrement())
  earnedAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  achievement   AchievementMaster @relation(fields: [achievementId], references: [id])
  achievementId Int

  @@unique([userId, achievementId])
}
